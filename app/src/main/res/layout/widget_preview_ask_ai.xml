<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+). Static illustration only; the live widget is drawn by Glance.
     It is inflated as RemoteViews by the launcher, where AppCompat's app:tint does not exist, so android:tint is right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_sparkle"
            android:tint="#FF14B8A6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/widget_ask_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
