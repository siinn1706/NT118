<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent "glass" widget panel: a soft vertical sheen with a hairline rim, like the in-app Liquid Glass cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:endColor="#D91C1C1E"
        android:startColor="#E02C2C2E"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#29FFFFFF" />
</shape>
